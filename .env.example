# Copy to .env.local for local development. NEVER commit real values.
# NOTE: VITE_ prefixed variables are embedded in the public build (see CONTRIBUTING.md).

# Google OAuth client id used for the encrypted Google Drive backup.
# Not a secret by itself, but it must be restricted to the app's origins in
# Google Cloud Console (see README > Google Drive setup).
VITE_GOOGLE_CLIENT_ID=
