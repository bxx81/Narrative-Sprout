# Copy to .env.local for local development. NEVER commit real values.
# NOTE: VITE_ prefixed variables are embedded in the public build (see CONTRIBUTING.md).

# Google OAuth client id used for the encrypted Google Drive backup.
# Not a secret by itself, but it must be restricted to the app's origins in
# Google Cloud Console (see README > Google Drive setup).
VITE_GOOGLE_CLIENT_ID=

# Desktop (Tauri) builds cannot show the Google popup, so consent runs in the
# OS browser as a PKCE loopback flow. Set the two values below from a
# "Desktop app" type OAuth client of the same Cloud project; when
# VITE_GOOGLE_CLIENT_ID_TAURI is unset, the Tauri build falls back to
# VITE_GOOGLE_CLIENT_ID above (which typically fails with a redirect
# mismatch). The secret is required by Google's token endpoint even for
# Desktop clients — installed apps cannot keep it, so it is a build-time
# value only (this file stays empty; the real values live in .env.tauri).
VITE_GOOGLE_CLIENT_ID_TAURI=
VITE_GOOGLE_CLIENT_SECRET_TAURI=
