# Dependencies
node_modules/

# Build output — never commit (Cloudflare Pages builds from source)
dist/
dist-ssr/

# Generated at build time by rollup-plugin-license (vite.config.ts): each
# build mode writes its own flavor — web -> public/legal, tauri ->
# src-tauri/resources/legal — so the contents differ per target and the
# files must never be committed.
public/legal/license.html
src-tauri/resources/legal/license.html

# Secrets — never commit (gitleaks + Secret Scanning enforced)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.local

# Logs
*.log

# Playwright E2E output — never commit
playwright-report/
test-results/

# Tauri (src-tauri/ lives in main; see knowledge/operations/desktop-app.md)
src-tauri/target/
src-tauri/gen/
