{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Narrative Sprout",
  "version": "2.0.0",
  "identifier": "dev.pages.narrative-sprout",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run tauri:dev",
    "beforeBuildCommand": "bun run tauri:build && bun scripts/separate-assets.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Narrative Sprout",
        "width": 1152,
        "height": 896,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**", "$APPDATA/**"]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/s": "s",
      "../public/images": "images"
    },
    "windows": {
      "nsis": {
        "languages": ["Japanese"]
      }
    }
  }
}
